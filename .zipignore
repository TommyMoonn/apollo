# Git metadata, generated output and local working data
# ^ anchors an exclusion to the workspace root (also supported by bsdtar).
.git
^target
^artifacts
^.scratch
^.agent-work
^.dev

# Sensitive local configuration
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# Temporary files and archives
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.zip

# Disposable verification output
^test-results
^coverage
